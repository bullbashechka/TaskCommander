{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "task-commander-local-api-v1",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SERVICE_ROLE_KEY",
      "MOCK_LAUNCH_SIGNING_SECRET",
      "SESSION_SIGNING_SECRET",
    ],
  },
  "vars": {
    "APP_ENV": "local",
    "BITRIX_ADAPTER": "mock",
    "LOCAL_SUPABASE_ALLOWED_HOSTS": "",
  },
  "queues": {
    "producers": [
      {
        "binding": "OPERATIONS_QUEUE",
        "queue": "task-commander-local-operations-v1",
        "remote": false,
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "REPORTS_BUCKET",
      "bucket_name": "task-commander-local-reports-v1",
      "remote": false,
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
