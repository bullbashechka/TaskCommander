{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "task-commander-runtime-test-v1",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "local",
    "BITRIX_ADAPTER": "mock",
    "SUPABASE_ALLOWED_ORIGINS": "https://dev.supabase.test",
    "APP_ORIGIN": "https://example.test",
    "BITRIX_PORTAL_ORIGIN": "https://portal.bitrix24.ru",
    "BITRIX_FRAME_ANCESTORS": "https://portal.bitrix24.ru",
    "BITRIX_MEDIA_ALLOWED_ORIGINS": "https://portal.bitrix24.ru",
    "ENABLE_LOCAL_RUNTIME_PROBE": "true",
    "LOCAL_RUNTIME_PROBE_TOKEN": "test-runtime-probe-token-0000000001",
    "INTERNAL_READINESS_TOKEN": "test-readiness-token-000000000000000001",
    "OPERATIONS_QUEUE_NAME": "task-commander-test-operations-v1",
    "ACCESS_COMMANDS_QUEUE_NAME": "task-commander-test-access-commands-v1",
    "MOCK_LAUNCH_SIGNING_SECRET": "test-mock-launch-signing-secret-0001",
    "SESSION_SIGNING_SECRET": "test-session-signing-secret-0000001",
  },
  "queues": {
    "producers": [
      {
        "binding": "OPERATIONS_QUEUE",
        "queue": "task-commander-test-operations-v1",
        "remote": false,
      },
      {
        "binding": "ACCESS_COMMANDS_QUEUE",
        "queue": "task-commander-test-access-commands-v1",
        "remote": false,
      },
    ],
  },
  "r2_buckets": [
    {
      "binding": "REPORTS_BUCKET",
      "bucket_name": "task-commander-test-reports-v1",
      "remote": false,
    },
  ],
  "ratelimits": [
    {
      "name": "SESSION_RATE_LIMITER",
      "namespace_id": "13901",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "PROBE_RATE_LIMITER",
      "namespace_id": "13902",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "ACCESS_FANOUT_RATE_LIMITER",
      "namespace_id": "13903",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
}
