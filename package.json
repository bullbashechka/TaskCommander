{
  "name": "task-commander",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "webapp",
    "backend",
    "packages/*"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run --cwd webapp dev",
    "dev:reset": "bun scripts/reset-local-runtime.mjs",
    "db:docker:start": "supabase start",
    "db:docker:stop": "supabase stop",
    "db:docker:reset": "supabase db reset --local",
    "db:docker:test": "supabase test db --local",
    "db:docker:lint": "supabase db lint --local",
    "build": "bun run --cwd webapp build",
    "preview": "bun run --cwd webapp preview",
    "typecheck": "bun run --cwd packages/contracts typecheck && bun run --cwd backend typecheck && bun run --cwd webapp typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run --cwd packages/contracts test && bun run --cwd backend test && bun run --cwd webapp test",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "cf-typegen": "bun run --cwd backend cf-typegen"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "supabase": "^2.113.0",
    "typescript-eslint": "^8.0.0"
  }
}
